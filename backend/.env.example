# Database
DATABASE_URL="postgresql://haitech:haitech_password@localhost:5432/haitech_crm?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Green API fallback
# Primary Green API is configured with GREEN_API_INSTANCE_ID/GREEN_API_TOKEN.
# If the primary instance is not authorized/online (for example yellowCard),
# CRM WhatsApp sends fall back to this second instance.
GREEN_API_FALLBACK_INSTANCE_ID=
GREEN_API_FALLBACK_TOKEN=
GREEN_API_HEALTH_CACHE_MS=60000

# Daily meeting validation report.
# Replaces the old host cron /home/ameidar/meetings_check.sh.
# Runs at 20:00 Israel time by default and sends through the CRM Green API client.
MEETINGS_CHECK_REPORT_ENABLED=true
MEETINGS_CHECK_REPORT_CRON=0 20 * * *
MEETINGS_CHECK_REPORT_PHONE=972528746137

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed (optional)
ADMIN_EMAIL=admin@haitech.co.il
ADMIN_PASSWORD=admin123
ADMIN_NAME=מנהל מערכת

# WhatsApp inbound router (optional)
# Keep Meta webhook pointed at the CRM and forward one phone-number stream to an external agent.
# Disabled unless WA_INBOUND_FORWARD_WEBHOOK_URL is set.
WA_INBOUND_FORWARD_PHONE_NUMBER_ID=
WA_INBOUND_FORWARD_WEBHOOK_URL=
WA_INBOUND_FORWARD_SECRET=
WA_INBOUND_FORWARD_TIMEOUT_MS=5000
