# Database
DATABASE_URL="postgresql://haitech:haitech_password@localhost:5432/haitech_crm?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Green API fallback
# Primary Green API is configured with GREEN_API_INSTANCE_ID/GREEN_API_TOKEN.
# If the primary instance is not authorized/online (for example yellowCard),
# CRM WhatsApp sends fall back to this second instance.
GREEN_API_FALLBACK_INSTANCE_ID=
GREEN_API_FALLBACK_TOKEN=
GREEN_API_HEALTH_CACHE_MS=60000

# Internal operations recipients for cycle/meeting alerts.
# Format: name|phone|email, comma-separated.
OPERATIONS_RECIPIENTS=עמי|0528746137|ami@hai.tech,קים|0543354550|navekim@gmail.com

# Daily meeting validation report.
# Replaces the old host cron /home/ameidar/meetings_check.sh.
# Runs at 20:00 Israel time by default and sends through the CRM Green API client.
MEETINGS_CHECK_REPORT_ENABLED=true
MEETINGS_CHECK_REPORT_CRON=0 20 * * *
MEETINGS_CHECK_REPORT_PHONE=972528746137

# Google Meet automation.
# Use either GOOGLE_MEET_CREDENTIALS_JSON or a local JSON file path.
GOOGLE_MEET_CREDENTIALS=
GOOGLE_MEET_CREDENTIALS_JSON=
GOOGLE_MEET_HOSTS=ami@hai.tech,inna@hai.tech,hila@hai.tech,info@hai.tech
GOOGLE_MEET_ARTIFACT_ALERT_DELAY_MINUTES=60

# YouTube publishing from /youtube.
# Use YOUTUBE_REFRESH_TOKEN for long-running production config, or
# YOUTUBE_OAUTH_TOKEN_FILE/YOUTUBE_OAUTH_TOKEN_JSON for a full OAuth token object.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_OAUTH_TOKEN_FILE=
YOUTUBE_OAUTH_TOKEN_JSON=
YOUTUBE_MAX_VIDEO_MB=500

# Official Meta WhatsApp reminders.
# Requires approved Meta templates; see docs/whatsapp-cloud-reminder-templates.md.
WA_REMINDER_PHONE_NUMBER_ID=
WA_REMINDER_BUSINESS_PHONE=+972533027763
WA_REMINDER_TEMPLATE_LANGUAGE=he

INSTRUCTOR_DAILY_REMINDER_WA_TEMPLATE_NAME=instructor_daily_schedule
INSTRUCTOR_PRE_LESSON_WA_TEMPLATE_NAME=instructor_pre_lesson_60m
INSTRUCTOR_STATUS_CHECK_WA_TEMPLATE_NAME=instructor_status_check
INSTRUCTOR_LAST_LESSON_WA_TEMPLATE_NAME=instructor_last_lesson_reminder
MANAGEMENT_UNRESOLVED_WA_TEMPLATE_NAME=management_unresolved_meetings

PARENT_REMINDER_WA_ENABLED=false
PARENT_REMINDER_WA_TEMPLATE_NAME=parent_lesson_reminder
# Optional newer split template. Leave empty to use the approved parent_lesson_reminder template for online lessons too.
PARENT_ONLINE_REMINDER_WA_TEMPLATE_NAME=
PARENT_REMINDER_WA_PHONE_NUMBER_ID=
PARENT_REMINDER_WA_BUSINESS_PHONE=+972533027763

LEAD_WELCOME_DEFAULT_TEMPLATE_NAME=lead_welcome_hai
LEAD_WELCOME_INTEREST_TEMPLATE_NAME=lead_welcome_course_interest
LEAD_WELCOME_TRIAL_TEMPLATE_NAME=lead_welcome_trial_or_campaign

# Internal new-lead admin alerts via official Meta WhatsApp templates.
# Green fallback remains enabled by default so the existing sales group alert keeps working.
LEAD_ADMIN_WA_TEMPLATE_ENABLED=false
LEAD_ADMIN_WA_TEMPLATE_NAME=lead_admin_new_lead
LEAD_ADMIN_WA_TEMPLATE_RECIPIENTS=0528746137,0543354550
LEAD_ADMIN_WA_PHONE_NUMBER_ID=
LEAD_ADMIN_WA_BUSINESS_PHONE=+972533027763
LEAD_ADMIN_GREEN_FALLBACK_ENABLED=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed (optional)
ADMIN_EMAIL=admin@haitech.co.il
ADMIN_PASSWORD=admin123
ADMIN_NAME=מנהל מערכת

# WhatsApp inbound router (optional)
# Keep Meta webhook pointed at the CRM and forward one phone-number stream to an external agent.
# Disabled unless WA_INBOUND_FORWARD_WEBHOOK_URL is set.
#
# Lead welcome templates should be sent from the CRM-owned number so replies
# stay in the CRM inbox instead of following the routed primary bot number.
LEAD_WELCOME_WA_PHONE_NUMBER_ID=
LEAD_WELCOME_WA_BUSINESS_PHONE=+972533009742

WA_INBOUND_FORWARD_PHONE_NUMBER_ID=
WA_INBOUND_FORWARD_WEBHOOK_URL=
WA_INBOUND_FORWARD_SECRET=
WA_INBOUND_FORWARD_TIMEOUT_MS=5000
